# Render Private Service (financial-helper-kure)
KURE_RUNTIME_HOST=0.0.0.0
KURE_RUNTIME_PORT=10000
KURE_DEVICE=cpu
KURE_INDEX_ROOT=/var/lib/kure/retrieval-indexes
HF_HOME=/var/lib/kure/huggingface
TRANSFORMERS_CACHE=/var/lib/kure/huggingface/transformers

# Populate the mounted disk with the reviewed CARD generation before the
# Backend is marked ready. The runtime must load the same generation identity
# as the PostgreSQL active_retrieval_generation row. Verify the UUID with the
# readiness endpoint; do not store it as a secret or hardcode it here.
