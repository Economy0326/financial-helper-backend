# Render Web Service (financial-helper-backend)
# Values marked sync:false in render.yaml must be entered in the Render
# dashboard or secret manager. Never commit real values.
SPRING_PROFILES_ACTIVE=prod
PORT=10000
SERVER_ADDRESS=0.0.0.0

# Render internal Postgres URL must be supplied in JDBC form.
DB_URL=jdbc:postgresql://<internal-host>:5432/<database>
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>

FRONTEND_ORIGIN=https://<vercel-project-domain>
KURE_RUNTIME_ENDPOINT=http://financial-helper-kure:10000
KURE_RUNTIME_ENABLED=true
LAW_OPEN_API_ENABLED=true
LAW_OC=<server-secret>
OPENAI_API_KEY=<server-secret>
AI_ENABLED=true

KAKAO_LOGIN_ENABLED=true
KAKAO_CLIENT_ID=<client-id>
KAKAO_CLIENT_SECRET=<server-secret>
KAKAO_REDIRECT_URI=https://<api-domain>/api/v1/auth/kakao/callback
KAKAO_FRONTEND_SUCCESS_URI=https://<app-domain>/account

NAVER_LOGIN_ENABLED=true
NAVER_CLIENT_ID=<client-id>
NAVER_CLIENT_SECRET=<server-secret>
NAVER_REDIRECT_URI=https://<api-domain>/api/v1/auth/naver/callback
NAVER_FRONTEND_SUCCESS_URI=https://<app-domain>/account

ACCOUNT_COOKIE_SECURE=true
ACCOUNT_COOKIE_SAME_SITE=Lax
GUEST_SESSION_COOKIE_SECURE=true
GUEST_SESSION_COOKIE_SAME_SITE=Lax

# Production defaults remain the Work 7 policy unless explicitly reviewed.
ACCOUNT_NEW_CONSULTATION_LIMIT=3
ACCOUNT_CONSULTATION_WINDOW_DAYS=7
ACCOUNT_MAX_ACTIVE_CONSULTATIONS=1
